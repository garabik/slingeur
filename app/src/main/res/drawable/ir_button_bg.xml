<?xml version="1.0" encoding="utf-8"?>
<!-- IR remote button background: transparent-ish fill (so video stays visible
     through it) with a visible outline, rather than a stock solid Button.
     D-pad/TV remote focus gets a distinct, brighter, thicker border, the
     only way to tell which button an OK press would activate when
     navigating by D-pad instead of touch. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#60000000" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <stroke android:width="2dp" android:color="#80FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
